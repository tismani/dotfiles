      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (model) (rate(llamacpp:tokens_predicted_total{model=~\"$model\"}[$__rate_interval])) / sum by (model) (rate(llamacpp:tokens_predicted_seconds_total{model=~\"$model\"}[$__rate_interval]))",
